# Desenvolvimento
DB_DEV_URL=jdbc:postgresql://localhost:5432/jogos_dev
DB_DEV_USERNAME=jogos_app
DB_DEV_PASSWORD=substitua_pela_senha_local

# Testes
DB_TEST_URL=jdbc:postgresql://localhost:5432/jogos_test
DB_TEST_USERNAME=jogos_app
DB_TEST_PASSWORD=substitua_pela_senha_local

# Produção: definidos pela plataforma, não pelo repositório
DB_URL=jdbc:postgresql://servidor:5432/banco
DB_USERNAME=usuario_da_aplicacao
DB_PASSWORD=substitua_pelo_segredo_da_plataforma
# Gerar localmente pelo menos 32 bytes aleatorios em Base64.
JWT_SECRET=substitua-por-chave-base64-de-256-bits

# Provisionamento inicial (habilitar somente durante o primeiro uso)
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_CPF=
INITIAL_ADMIN_LOGIN=
INITIAL_ADMIN_PASSWORD=
